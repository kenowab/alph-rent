# Copy to backend/.env and fill in your values.

# ---- Server ----
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/alpha-rent-ethio

# JWT signing secret (use a long random string)
JWT_SECRET=change-me

# Token lifetime (defaults to 30d)
JWT_EXPIRES_IN=30d

# Comma-separated list of allowed origins. Leave empty to allow all (dev).
CORS_ORIGIN=http://localhost:3000

# ---- Admin account (used by `npm run create:admin`) ----
# Never commit a real password — set a strong value locally.
ADMIN_EMAIL=admin@alpharent.et
ADMIN_PASSWORD=

# ---- Google OAuth ("Continue with Google") ----
# Client ID is public; set the matching secret only in your local backend/.env.
GOOGLE_CLIENT_ID=163340503817-o11j84f0d2ia6m5m9tel5tndn2q3c85f.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ---- AI Chatbot & Description Generator ----
# Gemini (free tier): get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash

# OpenAI fallback (optional)
OPENAI_API_KEY=

# ---- Email notifications ----
# Preferred API-key based provider. If set, the mailer will try this first.
# Example: EMAIL_API_KEY=your_provider_key_here
EMAIL_API_KEY=
EMAIL_PROVIDER=resend
EMAIL_FROM_NAME=Alpha Rent Ethiopia
EMAIL_FROM_ADDRESS=

# Gmail SMTP / Nodemailer fallback
# Set your Gmail address and 16-character App Password if you want to use SMTP instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

CLIENT_BASE_URL=http://localhost:3000
